{
	"mcpServers": {
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--browser",
				"msedge"
			]
		},
		"filesystem": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:/Learn-AI-tools-Build-AI-Agents-for-Software-Testing"
			],
			"env": {
				"REST_BASE_URL": "https://rahulshettyacademy.com",
				"HEADER_Accept": "application/json"
			}
		},
		"excel-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@smithery/cli@latest",
				"run",
				"@negokaz/excel-mcp-server",
				"--key",
				"${SMITHERY_API_KEY}"
			]
		},
		"rest-api": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"dkmaker-mcp-rest-api"
			],
			"env": {
				"REST_BASE_URL": "https://rahulshettyacademy.com",
				"HEADER_Accept": "application/json"
			}
		},
		"mysql": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"mysql-mcp-server",
				"mysql_mcp_server"
			],
			"env": {
				"MYSQL_HOST": "localhost",
				"MYSQL_PORT": "3306",
				"MYSQL_USER": "root",
				"MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
				"MYSQL_DATABASE": "rahulshettyacademy"
			}
		},
		"csv-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"excel-csv-mcp-server"
			],
			"env": {
				"EXCEL_MCP_WORKSPACE_ROOT": "C:/Learn-AI-tools-Build-AI-Agents-for-Software-Testing"
			}
		}
	}
}
